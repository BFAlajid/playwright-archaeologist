{
  "name": "playwright-archaeologist",
  "version": "0.2.0",
  "description": "Crawl any running web app and generate a complete behavioral specification — sitemap, forms, APIs, screenshots, and regression baselines",
  "author": "playwright-archaeologist contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BFAlajid/playwright-archaeologist.git"
  },
  "bugs": {
    "url": "https://github.com/BFAlajid/playwright-archaeologist/issues"
  },
  "homepage": "https://github.com/BFAlajid/playwright-archaeologist#readme",
  "keywords": [
    "playwright",
    "crawler",
    "web-crawler",
    "sitemap",
    "screenshots",
    "openapi",
    "api-discovery",
    "behavioral-testing",
    "regression-testing",
    "spa",
    "forms",
    "flow-graph",
    "web-scraping",
    "qa",
    "testing",
    "audit"
  ],
  "bin": {
    "playwright-archaeologist": "./bin/cli.js",
    "pa": "./bin/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:security": "vitest run test/security",
    "test:e2e": "vitest run test/e2e",
    "bench": "vitest bench test/performance/",
    "bench:ci": "vitest bench test/performance/ --reporter=json --outputFile=bench-results.json",
    "test:bench-check": "vitest run test/performance/enforce-budget.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.2",
    "commander": "^13.0.0",
    "ora": "^8.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.0",
    "eslint": "^9.18.0",
    "execa": "^9.5.0",
    "express": "^4.21.0",
    "fast-check": "^3.23.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
